#!/bin/sh
# =============================================================
# zzz-default-settings  (uci-defaults orchestrator)
#
# Runs ONCE on first boot (OpenWrt uci-defaults mechanism).
# Delegates all configuration to numbered modules installed
# at /usr/lib/wyhome/modules/ by diy-part2.sh at build time.
#
# Module execution order (alphabetical by filename):
#   10-system.sh    — language, timezone, network, opkg, dhcp
#   20-firewall.sh  — flow_offloading defaults
#   30-openclash.sh — OpenClash UCI sync with clash yaml
#   35-nikki.sh     — Nikki UCI (alternate proxy, disabled by default)
#   36-homeproxy.sh — HomeProxy UCI (alternate proxy, disabled by default)
#   40-cleanup.sh   — disable unused services, cache cleanup
#
# To add new configuration: create NN-name.sh in diy/modules/
# and it will be picked up automatically at the next build.
# =============================================================

MODULES_DIR="/usr/lib/wyhome/modules"

if [ ! -d "$MODULES_DIR" ]; then
    echo "[zzz] WARNING: modules directory not found: $MODULES_DIR"
    exit 0
fi

for _mod in "$MODULES_DIR"/[0-9][0-9]-*.sh; do
    [ -f "$_mod" ] || continue
    echo "[zzz] Running module: $(basename $_mod)"
    # Source (dot) runs in current shell — modules can set uci/env vars
    # and share state. || true prevents set -e from aborting on module errors.
    . "$_mod" || echo "[zzz] WARNING: $(basename $_mod) returned error (continuing)"
done

echo "[zzz] All modules completed"
exit 0
