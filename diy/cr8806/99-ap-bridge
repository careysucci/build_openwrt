#!/bin/sh
# =============================================================
# uci-defaults: 99-ap-bridge
# Target: Xiaomi CR8806 / Redmi AX3000 — ImmortalWrt 25.12 AP build
#
# Runs once at first boot. Timing is safe: /etc/init.d/boot executes
#   config_generate  → /etc/config/network exists
#   wifi config      → /etc/config/wireless exists (radio0/radio1)
#   uci_apply_defaults → THIS script
# The script deletes itself after a successful run (exit 0).
#
# What it does:
#   1. Bridges ALL ethernet ports (incl. WAN) into br-lan — wired relay
#   2. Static management IP 172.16.3.19/21 (gw/dns → main router .18)
#   3. Disables dnsmasq/odhcpd/firewall — the main router serves these
#   4. Enables dual-band WiFi, same SSID on both bands:
#      - 2.4G: HE20, auto channel
#      - 5G:   HE80, channel 36 (non-DFS → no radar wait, up instantly)
#      - 802.11r/k/v fast roaming with a shared mobility domain
#   5. System: hostname, timezone, LuCI language
#
# Multi-AP roaming: flash every CR8806 with this same firmware and the
# SSID/password/mobility-domain match automatically — clients roam
# seamlessly over Ethernet backhaul. For wireless mesh instead, add an
# 802.11s interface in LuCI (wpad-openssl already supports SAE mesh).
# =============================================================

echo "[99-ap-bridge] configuring bridged-AP mode..."

# ---- 1. Network: bridge the WAN port into br-lan --------------------
# DSA layout on CR8806: br-lan over lan1/lan2, wan as standalone port.
# Add 'wan' to the bridge so every port serves the LAN (wired relay).
idx=0
while uci -q get "network.@device[$idx]" >/dev/null 2>&1; do
    if [ "$(uci -q get "network.@device[$idx].name")" = "br-lan" ]; then
        uci -q del_list "network.@device[$idx].ports=wan" 2>/dev/null
        uci -q add_list "network.@device[$idx].ports=wan"
        echo "[99-ap-bridge] WAN port bridged into br-lan"
    fi
    idx=$((idx + 1))
done

# Remove routed WAN interfaces — an AP does not route
uci -q delete network.wan
uci -q delete network.wan6

# Static management address (change to a free IP of your main LAN)
uci set network.lan.proto='static'
uci set network.lan.ipaddr='172.16.3.19'
uci set network.lan.netmask='255.255.248.0'
uci set network.lan.gateway='172.16.3.18'
uci set network.lan.dns='172.16.3.18'
uci set network.lan.delegate='0'
uci -q delete network.lan.ip6assign

# Packet steering: spread RX softirq load across both A53 cores, so a single
# core cannot bottleneck WiFi<->wired bridging at gigabit line rate.
# (netifd >= 22.03 honors network.globals.packet_steering → RPS on all ifaces)
uci set network.globals.packet_steering='1'
uci commit network

# ---- 2. Disable DHCP/DNS/firewall (main router's job) ---------------
uci set dhcp.lan.ignore='1'
uci commit dhcp
/etc/init.d/dnsmasq disable 2>/dev/null || true
/etc/init.d/odhcpd disable 2>/dev/null || true
/etc/init.d/firewall disable 2>/dev/null || true
echo "[99-ap-bridge] dnsmasq/odhcpd/firewall disabled"

# ---- 3. System ------------------------------------------------------
uci set system.@system[0].hostname='WyHouse-AP'
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci commit system
# LuCI 24.10+ uses BCP47 codes (zh_Hans), not the legacy zh_cn.
uci set luci.main.lang='zh_Hans'
uci commit luci

# ---- 4. WiFi: dual-band, one SSID, fast roaming ---------------------
# /etc/config/wireless is generated by `wifi config` before uci-defaults.
if [ -s /etc/config/wireless ]; then
    # Radio-level settings, keyed by band (robust to radio naming)
    r=0
    while uci -q get "wireless.@wifi-device[$r]" >/dev/null 2>&1; do
        band="$(uci -q get "wireless.@wifi-device[$r].band")"
        uci set "wireless.@wifi-device[$r].disabled=0"
        uci set "wireless.@wifi-device[$r].country=CN"
        case "$band" in
            2g)
                uci set "wireless.@wifi-device[$r].channel=auto"
                uci set "wireless.@wifi-device[$r].htmode=HE20"
                ;;
            5g)
                # ch36 + HE80: non-DFS, usable immediately after boot.
                # (160MHz is regdb-blocked in CN anyway.)
                uci set "wireless.@wifi-device[$r].channel=36"
                uci set "wireless.@wifi-device[$r].htmode=HE80"
                ;;
        esac
        r=$((r + 1))
    done

    # Interface-level: identical SSID/key on both bands + 802.11r/k/v.
    # ft_psk_generate_local=1 → no R0KH/R1KH lists needed across APs.
    i=0
    while uci -q get "wireless.@wifi-iface[$i]" >/dev/null 2>&1; do
        uci set "wireless.@wifi-iface[$i].ssid=WyHouse"
        uci set "wireless.@wifi-iface[$i].encryption=psk2"
        uci set "wireless.@wifi-iface[$i].key=wyhouse8888"
        uci set "wireless.@wifi-iface[$i].ieee80211r=1"
        uci set "wireless.@wifi-iface[$i].mobility_domain=8888"
        uci set "wireless.@wifi-iface[$i].ft_over_ds=1"
        uci set "wireless.@wifi-iface[$i].ft_psk_generate_local=1"
        uci set "wireless.@wifi-iface[$i].ieee80211k=1"
        uci set "wireless.@wifi-iface[$i].ieee80211v=1"
        i=$((i + 1))
    done
    uci commit wireless
    echo "[99-ap-bridge] WiFi up: 2.4G(HE20/auto) + 5G(HE80/ch36), SSID=WyHouse, 802.11r/k/v on"
else
    echo "[99-ap-bridge] WARNING: /etc/config/wireless missing — configure WiFi via LuCI"
fi

echo "[99-ap-bridge] done. LuCI: http://172.16.3.19 (root, no password)"
exit 0
