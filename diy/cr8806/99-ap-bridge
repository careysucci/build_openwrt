#!/bin/sh
# =============================================================
# uci-defaults: 99-ap-bridge
# Target: Xiaomi CR8806 / Redmi AX3000 + Xiaomi CR881x (CR8816/8818/8819)
#         — ImmortalWrt 25.12 router build (one build, two device images)
#
# [Filename kept for continuity] This script NO LONGER configures
# bridged-AP mode: the image boots as a STANDARD ROUTER — LAN pinned to
# 172.16.3.19/24 on BOTH boards (CR880X and CR881x alike, per the
# 2026-10-13 management-address decision), DHCP
# server, firewall and routed WAN (DHCP client or PPPoE, both work out
# of the box). It only brands the box and provisions the WiFi below.
# Converting to a bridged AP is a manual on-device step (recipe in this
# header, just below).
#
# Manual bridge-AP conversion (do it ONLY when you actually want it):
#   1. LuCI → Network → Interfaces → Devices → br-lan → add port 'wan'
#   2. LuCI → Network → Interfaces → delete wan & wan6; edit lan →
#      static address of the MAIN LAN (IP / mask / gateway / DNS)
#   3. LuCI → Network → DHCP/DNS → disable DHCP on lan
#   4. LuCI → System → Startup → disable firewall + dnsmasq
#   (equivalent uci: add 'wan' to the br-lan device ports; delete
#    network.wan / network.wan6; network.lan proto=static + ipaddr/
#    netmask/gateway/dns; dhcp.lan.ignore=1; disable both services)
#
# Runs once at first boot, from uci_apply_defaults inside
# /etc/init.d/boot (START=10) — i.e. after kmodloader and BEFORE netifd
# starts. config_generate ran during preinit, so /etc/config/network and
# /etc/config/system exist by then. /etc/config/wireless does NOT: it is
# created by the ieee80211 hotplug once the ath11k phys register, which
# on this board happens AFTER uci_apply_defaults starts (kmodloader
# finishes ~18s, ath11k probes complete ~19s). The WiFi section below
# therefore WAITS for the radios — see its comment.
# The script deletes itself after a successful run (exit 0); on WiFi
# timeout it exits 1 so it is retried on the next boot.
#
# What it does (everything else stays STOCK router defaults):
#   1. LAN pinned to 172.16.3.19/24 on BOTH boards (CR880X and CR881x) —
#      ONLY on a factory-fresh config; a settings-kept sysupgrade of an
#      already-deployed box (e.g. one converted to a bridged AP with its
#      own management IP) keeps its address untouched
#   2. WAN port conduit unified to eth1 — CR880X ONLY: the stock eth0
#      conduit (GMAC0 PHY-to-PHY into QCA8337 port 5) has no working RX
#      on mainline qca8k (openwrt#24696); without it the routed WAN DHCP
#      client never hears a reply (verified on-device 2026-09-30).
#      The CR881x (YT9215) is single-conduit — wan already rides eth1
#      via the switch CPU port, nothing to override
#   3. System: hostname, timezone, LuCI language
#   4. packet_steering=1: RX softirqs spread over both A53 cores
#   5. Enables dual-band WiFi, same SSID on both bands — ONLY on a
#      factory-fresh wireless config; a guard mirrors the LAN one, so a
#      settings-kept sysupgrade never overwrites an admin-configured WLAN:
#      - PER-BOARD channel plan: the two deployed APs (CR880X + CR881x)
#        broadcast the same SSIDs and must never share a channel
#        (measured 2026-10-15: both on ch1+ch149 at -44..-74 dBm mutual
#        visibility, co-channel CSMA deferral halves airtime)
#      - 2.4G: HE40, ch1 (CR880X: quietest on-site, noise floor -95 dBm)
#        / ch11 (CR881x: strongest neighbour -51 dBm vs -46 on ch6).
#        40 MHz doubles the 2x2 HE PHY rate vs HE20; hostapd falls back
#        to HE20 when the secondary 20 MHz is busy (both ch1 and ch11
#        measured landing at 20 MHz on-site)
#      - 5G:   HE80, ch149 (CR880X: non-DFS, up instantly, 30 dBm class,
#        near-empty segment) / ch36 (CR881x: UNII-1, universally
#        client-supported, strongest neighbour -77 dBm on-site). HE80 is
#        the max for iPhone-12-class clients. QCN6122 does negotiate
#        HE160 too — measured on-device at 1297/1153 Mbps PHY, iperf3
#        465/355 Mbps through the 5G link — but HE160 would force DFS
#        channels with CAC/radar risk
#      - country US: ath11k firmware is self-managed US on this board;
#        the BDF caps real output at 23 dBm (2.4G) / 27 dBm (5G) anyway,
#        while CN regdb would only lower the ceilings (measured)
#      - 802.11r/k/v fast roaming with a shared mobility domain
#      - disassoc_low_ack=0: don't kick weak-signal IoT clients
#
# Multi-AP roaming (valid once the boxes are converted to bridge mode):
# flashing every box (CR880X and CR881x alike) with this same firmware gives them identical
# SSID/password/mobility-domain — clients roam seamlessly over the
# Ethernet backhaul, each box on its own channels (per-board plan above)
# so the APs never fight for the same airtime. For wireless mesh instead,
# add an 802.11s interface in LuCI (wpad-openssl already supports SAE mesh).
# =============================================================

echo "[99-ap-bridge] provisioning router-mode branding + WiFi..."

# Board dispatch: only used by the CR880X-only WAN conduit workaround
# below. Both boards share the same management address 172.16.3.19/24.
board="$(cat /tmp/sysinfo/board_name 2>/dev/null)"
lan_ip='172.16.3.19'

# ---- 1. Network: fixed management IP + packet steering ---------------
# LAN is pinned to 172.16.3.19/24 on both boards. config_generate wrote
# stock 192.168.1.1/24 during preinit;
# this overrides it from uci_apply_defaults (START=10), which runs BEFORE
# netifd (START=20) first starts — so the box comes up reachable at .19
# on first boot, no window where it answers at 192.168.1.1. DHCP server,
# firewall and the routed WAN interface stay EXACTLY as generated (WAN as
# DHCP client — switch to PPPoE in LuCI if the broadband line requires
# it). No gateway/DNS is set on lan: in router mode the box itself is the
# LAN gateway (add them only if you convert to a bridged AP, recipe in
# the header). NOTE: if the WAN uplink also lives in 172.16.3.0/24,
# routed mode gets a WAN/LAN subnet clash — use the bridged-AP recipe
# instead in that case.
#
# Idempotency (measured the hard way, 2026-10-01): uci-defaults also run
# after a settings-kept sysupgrade, when /etc/config/network carries the
# admin's own address. Pinning unconditionally then RESETS a deployed
# box's management IP (an AP at 172.16.0.226 was flipped back to .19 —
# the admin found the box at the wrong address and went spelunking in
# LuCI). Guard: only pin when lan still holds the factory default
# (192.168.1.1) or has no address at all. NOTE: 25.12 config_generate
# writes the factory default in CIDR form ("192.168.1.1/24") — strip
# the /suffix before comparing, or the guard never matches and the pin
# is silently skipped (measured on CR8816 first boot 2026-10-13).
# Packet steering: spread RX softirq load across both A53 cores, so a
# single core cannot bottleneck WiFi<->wired forwarding at line rate.
# (netifd >= 22.03 honors network.globals.packet_steering → RPS on all ifaces)
lan_cur_ip="$(uci -q get network.lan.ipaddr)"
lan_cur_ip="${lan_cur_ip%%/*}"
if [ -z "$lan_cur_ip" ] || [ "$lan_cur_ip" = "192.168.1.1" ]; then
    uci set network.lan.proto='static'
    uci set network.lan.ipaddr="$lan_ip"
    uci set network.lan.netmask='255.255.255.0'
else
    echo "[99-ap-bridge] lan already at $lan_cur_ip — keeping it (settings-kept upgrade)"
fi
uci set network.globals.packet_steering='1'
# WAN conduit -> eth1: CR880X ONLY. On the CR880X the wan port ships on
# conduit eth0 (GMAC0 PHY-to-PHY into QCA8337 port 5) and that path has
# NO working RX on the mainline qca8k driver (openwrt#24696, same wiring
# as the Redmi AX5400; dmesg: adpt_mp_port_netdev_change_notify
# "incorrect port 0"). Without this override the routed WAN DHCP client
# never receives a reply, and a bridged wan port passes no traffic (both
# verified on-device 2026-09-30; fix evidence: /sys/class/net/wan/lower_eth1).
# The CR881x (YT9215) is a single-conduit design — wan already rides
# eth1 through the switch CPU port, nothing to override.
# A `config device` section naming wan overrides board.json's
# network_device.wan.conduit; reuse an existing section if one exists
# (two sections for one device are not an option). Runs before netifd
# (START=20) first starts, so first boot already comes up with a
# working WAN port.
if [ "$board" != "xiaomi,cr881x" ]; then
    wsec="$(uci show network 2>/dev/null | sed -n "s/^\(network\.[^=]*\)\.name='wan'$/\1/p" | head -n1)"
    [ -n "$wsec" ] || wsec="$(uci add network device)"
    uci set "$wsec.name=wan"
    uci set "$wsec.conduit=eth1"
fi
uci commit network

# ---- 2. System ------------------------------------------------------
uci set system.@system[0].hostname='WyHouse-AP'
uci set system.@system[0].timezone='CST-8'
uci set system.@system[0].zonename='Asia/Shanghai'
uci commit system
# LuCI 24.10+ uses BCP47 codes (zh_Hans), not the legacy zh_cn.
uci set luci.main.lang='zh_Hans'
uci commit luci

# ---- 3. WiFi: dual-band, one SSID, fast roaming ---------------------
# Wait for the ieee80211 hotplug to create /etc/config/wireless when the
# ath11k phys register — on this board they appear ~1s after this script
# starts (the two probes land ~0.3s apart, so wait for BOTH radios, not
# just for the file to exist; max 60s). netifd starts after boot()
# returns (START=20 vs 10) and reads the committed config, so no
# explicit `wifi reload` is needed here.
count_radios() {
    uci -q show wireless 2>/dev/null | grep -c '=wifi-device'
}

n=0
while [ "$(count_radios)" -lt 2 ] && [ "$n" -lt 60 ]; do
    sleep 1
    n=$((n + 1))
done

if [ "$(count_radios)" -ge 1 ]; then
    # Factory-fresh guard (mirrors the LAN guard in section 1):
    # uci-defaults also re-run after a settings-kept sysupgrade, and this
    # section would otherwise OVERWRITE an admin-configured WLAN (an AP
    # running SSID "wy_house" with SAE would be flipped to WyHouse/psk2
    # and drop every client). Stock `wifi config` generates wifi-iface
    # sections WITHOUT an ssid, so any non-empty ssid means the radios
    # were configured by hand — keep them untouched.
    wif_ssid="$(uci -q get "wireless.@wifi-iface[0].ssid")"
    if [ -n "$wif_ssid" ]; then
        echo "[99-ap-bridge] wifi already provisioned (ssid='$wif_ssid') — keeping it (settings-kept upgrade)"
        echo "[99-ap-bridge] done. LuCI: http://172.16.3.19 (root, no password)"
        exit 0
    fi

    # Per-board channel plan: the two deployed APs broadcast the same
    # SSIDs and must never share a channel — measured 2026-10-15 with
    # both boxes on ch1+ch149 at -44..-74 dBm mutual visibility:
    # co-channel CSMA deferral halves airtime on both. CR880X keeps the
    # measured-quietest ch1/ch149; CR881x takes ch11/ch36 (strongest
    # neighbours -51 dBm on ch11 vs -46 on ch6; -77 dBm in 36-48).
    if [ "$board" = "xiaomi,cr881x" ]; then
        ch_2g=11
        ch_5g=36
    else
        ch_2g=1
        ch_5g=149
    fi

    # Radio-level settings, keyed by band (robust to radio naming)
    r=0
    while uci -q get "wireless.@wifi-device[$r]" >/dev/null 2>&1; do
        band="$(uci -q get "wireless.@wifi-device[$r].band")"
        uci set "wireless.@wifi-device[$r].disabled=0"
        # US regdom (see header): matches the ath11k self-managed domain on
        # this board; real txpower is BDF-capped at 23/27 dBm regardless.
        uci set "wireless.@wifi-device[$r].country=US"
        case "$band" in
            2g)
                # HE40: full speed for 2.4G (2x2 HE40 ≈ 287 Mbps PHY vs
                # 143 at HE20); hostapd falls back to HE20 when the
                # secondary 20 MHz turns out busy (both ch1 and ch11
                # measured landing at 20 MHz on-site).
                uci set "wireless.@wifi-device[$r].channel=$ch_2g"
                uci set "wireless.@wifi-device[$r].htmode=HE40"
                ;;
            5g)
                # HE80: the max for iPhone-12-class clients; QCN6122
                # does support HE160 (measured: 1297/1153 Mbps PHY) but
                # HE160 would force DFS channels with CAC/radar risk.
                uci set "wireless.@wifi-device[$r].channel=$ch_5g"
                uci set "wireless.@wifi-device[$r].htmode=HE80"
                ;;
        esac
        r=$((r + 1))
    done

    # Interface-level: identical SSID/key on both bands + 802.11r/k/v.
    # ft_psk_generate_local=1 → no R0KH/R1KH lists needed across APs.
    i=0
    while uci -q get "wireless.@wifi-iface[$i]" >/dev/null 2>&1; do
        uci set "wireless.@wifi-iface[$i].ssid=WyHouse"
        uci set "wireless.@wifi-iface[$i].encryption=psk2"
        uci set "wireless.@wifi-iface[$i].key=wyhouse8888"
        uci set "wireless.@wifi-iface[$i].ieee80211r=1"
        uci set "wireless.@wifi-iface[$i].mobility_domain=8888"
        uci set "wireless.@wifi-iface[$i].ft_over_ds=1"
        uci set "wireless.@wifi-iface[$i].ft_psk_generate_local=1"
        uci set "wireless.@wifi-iface[$i].ieee80211k=1"
        uci set "wireless.@wifi-iface[$i].ieee80211v=1"
        # Keep weak-signal IoT clients attached (verified on-device)
        uci set "wireless.@wifi-iface[$i].disassoc_low_ack=0"
        uci set "wireless.@wifi-iface[$i].wmm=1"
        i=$((i + 1))
    done
    uci commit wireless
    echo "[99-ap-bridge] WiFi up: 2.4G(HE40/ch$ch_2g) + 5G(HE80/ch$ch_5g), SSID=WyHouse, 802.11r/k/v on"
else
    echo "[99-ap-bridge] WARNING: no wifi-device in /etc/config/wireless after 60s"
    echo "[99-ap-bridge] WiFi NOT provisioned — exiting 1 to retry on next boot"
    exit 1
fi

echo "[99-ap-bridge] done. LuCI: http://172.16.3.19 (root, no password)"
exit 0
