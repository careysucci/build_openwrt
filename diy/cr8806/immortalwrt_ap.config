# ==================================================================
# Xiaomi CR8806 / Redmi AX3000 + Xiaomi CR881x (CR8816/8818/8819) —
# ImmortalWrt openwrt-25.12 router build (one build, two images)
# Source: immortalwrt/immortalwrt (branch openwrt-25.12, kernel 6.12)
#         + device support injected from diy/cr8806/adapter-25.12:
#         - redmi_ax3000 (CR880X, QCA8337 switch): ported from the
#           kmiit/Redmi_AX3000_immortalwrt adaptation
#         - xiaomi_cr881x (CR8816/8818/8819, Motorcomm YT9215 switch):
#           DTS + static BDFs from hzyitc/openwrt-redmi-ax3000, YT921x
#           DSA driver backport (mainline v8 + REVSGMII hack, 0913-0915)
#
# Standard-router profile — DHCP server / firewall / routed WAN all
# stock (PPPoE-ready). LuCI + dual-band WiFi (802.11r/k/v roaming) +
# diagnostic tools; no proxy/NAS/download apps, small footprint.
# First boot: diy/cr8806/99-ap-bridge brands the box and provisions the
# WiFi only. Bridge-AP conversion is a manual on-device step.
#
# Router essentials (dnsmasq-full, firewall4, nftables, kmod-nft-offload,
# odhcp6c/odhcpd-ipv6only, ppp, ppp-mod-pppoe) come from the ImmortalWrt
# DEVICE_TYPE=router default packages — nothing to pin here.
# ==================================================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
# Multi-device build (buildbot style). NOTE: the plain DEVICE_ symbols are
# members of the single-select "Target Profile" choice — writing two of them
# =y makes defconfig silently keep only the last one and the redmi_ax3000
# image disappears. MULTI_PROFILE + TARGET_DEVICE_* entries + per-device
# rootfs is the correct pattern for building both images in one run.
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_redmi_ax3000=y
CONFIG_TARGET_DEVICE_qualcommax_ipq50xx_DEVICE_xiaomi_cr881x=y
CONFIG_TARGET_PER_DEVICE_ROOTFS=y

#
# LuCI (web UI) + Chinese translation
#
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

#
# SSH file transfer
#
CONFIG_DROPBEAR_SCP=y
CONFIG_PACKAGE_openssh-sftp-server=y

#
# Diagnostic tools (small CLI utilities, no LuCI apps)
#
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y

#
# Network performance: dual-core IRQ balancing (ath11k WiFi IRQs vs ethernet
# IRQs on separate A53 cores) — required to sustain gigabit line rate.
#
CONFIG_PACKAGE_irqbalance=y

#
# Trim target defaults not needed on this box
# (CR8806 has no USB port; cpufreq was dropped for ipq5018 upstream)
#
# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_luci-app-cpufreq is not set

#
# ===== WiFi stack =====
# Pulled in by target/device defaults (kmod-ath11k-ahb, wpad-openssl,
# the merged ath11k-firmware-ipq5018-qcn6122 package); pinned explicitly
# so a default change can never drop the 5G radio.
#   ath11k-firmware-ipq5018-qcn6122 : 2.4G + 5G firmware (merged in 25.12)
#   ipq-wifi-redmi_ax3000           : CR880X board data (BDF) — dynamic
#                                      QCN6122 BDF (see 12-ath11k-...)
#   ipq-wifi-xiaomi_cr881x          : CR881x static BDFs — both radios
#                                      (qmi-board-id 0x23 / 0x60)
#   wpad-openssl                    : full hostapd — 802.11r/k/v roaming
#
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
# The two ipq-wifi BDF packages must be =m, never =y: the injected entries
# chain CONFLICTS (generate-ipq-wifi-package PREV_BOARD), so two =y entries
# would be mutually exclusive and the loser would be silently dropped from
# the rootfs (the 2026.10.12 build shipped redmi's BDF inside the CR881x
# image). As =m both compile fine; per-device rootfs installs each device's
# own BDF into its own image only.
CONFIG_PACKAGE_ipq-wifi-redmi_ax3000=m
CONFIG_PACKAGE_ipq-wifi-xiaomi_cr881x=m
CONFIG_PACKAGE_wpad-openssl=y
