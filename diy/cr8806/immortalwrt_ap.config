# ==================================================================
# Xiaomi CR8806 / Redmi AX3000 — ImmortalWrt openwrt-25.12 AP build
# Source: immortalwrt/immortalwrt (branch openwrt-25.12, kernel 6.12)
#         + CR8806 device support injected from diy/cr8806/imwrt-25.12
#         (ported from kmiit/Redmi_AX3000_immortalwrt adaptation)
#
# Pure bridged-AP profile:
#   LuCI + dual-band WiFi (802.11r/k/v roaming) + wired relay.
#   No proxy/NAS/download apps — AP-only duties, small footprint.
# First boot: diy/cr8806/99-ap-bridge applies bridge + WiFi + mgmt IP.
# ==================================================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_redmi_ax3000=y

#
# LuCI (web UI) + Chinese translation
#
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y

#
# SSH file transfer
#
CONFIG_DROPBEAR_SCP=y
CONFIG_PACKAGE_openssh-sftp-server=y

#
# Diagnostic tools (small CLI utilities, no LuCI apps)
#
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y

#
# Trim target defaults not needed on a dumb AP
# (CR8806 has no USB port; cpufreq was dropped for ipq5018 upstream)
#
# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_luci-app-cpufreq is not set

#
# ===== WiFi stack =====
# Pulled in by target/device defaults (kmod-ath11k-ahb, wpad-openssl,
# the merged ath11k-firmware-ipq5018-qcn6122 package); pinned explicitly
# so a default change can never drop the 5G radio.
#   ath11k-firmware-ipq5018-qcn6122 : 2.4G + 5G firmware (merged in 25.12)
#   ipq-wifi-redmi_ax3000           : board data (BDF) — both radios
#   wpad-openssl                    : full hostapd — 802.11r/k/v roaming
#
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_ipq-wifi-redmi_ax3000=y
CONFIG_PACKAGE_wpad-openssl=y
