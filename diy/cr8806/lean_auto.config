# ==================================================================
# Xiaomi CR8806 / Redmi AX3000 (Qualcomm IPQ5018, Cortex-A53)
# Source: hzyitc/openwrt-redmi-ax3000 (OpenWrt 23.05 base, Linux 5.15)
# Adapted from diy/x86/lean_auto.config — same feature set, ARM-tuned.
#
# Hardware limits: 128MB NAND / 256MB RAM
#   - No NSS offload in mainline builds: wired NAT is CPU-bound
#   - WiFi works via ath11k (2.4G IPQ5018 built-in + 5G QCN6122),
#     disabled by default per OpenWrt convention — enable in LuCI
#   - Keep package count lean: stacking all proxy apps may exceed flash
# ==================================================================
CONFIG_TARGET_ipq50xx=y
CONFIG_TARGET_ipq50xx_arm=y
CONFIG_TARGET_ipq50xx_arm_DEVICE_redmi_ax3000=y

#
# SSH file transfer
#
CONFIG_DROPBEAR_SCP=y
CONFIG_PACKAGE_openssh-sftp-server=y

#
# Translations
#
CONFIG_LUCI_LANG_zh_Hans=y

#
# ===== Kernel Optimization =====
#
CONFIG_KERNEL_SMP=y
CONFIG_KERNEL_RPS=y
CONFIG_KERNEL_XPS=y
CONFIG_KERNEL_NETDEVICES_MULTIQUEUE=y
CONFIG_KERNEL_CC_OPTIMIZE_FOR_PERFORMANCE=y
CONFIG_KERNEL_PREEMPT_NONE=y

#
# ===== TCP BBR Congestion Control =====
#
CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-fq=y

#
# ===== Kernel conntrack performance (required by nlbwmon) =====
#
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

#
# ===== IRQ Balancing =====
#
CONFIG_PACKAGE_irqbalance=y
CONFIG_PACKAGE_ethtool=y

#
# ===== Hardware Monitoring (SoC temperature) =====
# IPQ5018 exposes temperature via tsens/hwmon; x86 coretemp/k10temp
# and lm-sensors are meaningless on ARM SoC — dropped.
#
CONFIG_PACKAGE_kmod-hwmon-core=y
CONFIG_PACKAGE_luci-app-temp-status=y

#
# ===== Base Components =====
#
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_netperf=y
CONFIG_PACKAGE_htop=y

#
# ===== LuCI Web Interface =====
# nginx instead of uhttpd (matches x86 config). On 256MB RAM, if memory
# pressure appears, revert to defaults: luci-nginx=n (uhttpd returns).
#
CONFIG_PACKAGE_luci-ssl=n
CONFIG_PACKAGE_luci-ssl-nginx=n
CONFIG_PACKAGE_luci-nginx=y

#
# ===== DNS Configuration =====
#
CONFIG_PACKAGE_dnsmasq=n
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_dhcpv6=y

#
# ===== Proxy =====
# ARM NOTE: the workflow deletes the pre-bundled amd64 clash_meta core
# after diy-part2 (useless on ARM, wastes NAND); OpenClash then fetches
# the armv7 core itself on first start. Module 30-openclash.sh
# core_version is also rewritten to linux-armv7 by the workflow.
#
# homeproxy is OFF: sing-box duplicates mihomo (nikki) and 128MB NAND
# is tight. Flip to =y only after shrinking something else.
#
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-app-homeproxy=n

#
# ===== Extended Packages =====
#
CONFIG_PACKAGE_luci-app-nlbwmon=y
CONFIG_PACKAGE_luci-app-netspeedtest=y
CONFIG_PACKAGE_luci-app-minidlna=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_nano-full=y

#
# ===== Themes =====
#
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y

#
# ===== Disable Unnecessary Apps =====
#
CONFIG_PACKAGE_luci-app-filetransfer=n
CONFIG_PACKAGE_luci-app-ssr-plus=n
CONFIG_PACKAGE_luci-app-vsftpd=n
CONFIG_PACKAGE_luci-app-ksmbd=n
CONFIG_PACKAGE_luci-app-bypass=n

#
# ===== Firewall4 (nftables) =====
# OpenWrt 23.05 ships firewall4 by default; its dependencies
# (nftables-json, kmod-nft-core/fib/nat/offload) are pulled in
# automatically. iptables stays out of the image.
#
CONFIG_PACKAGE_firewall4=y
