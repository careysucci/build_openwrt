# ==================================================================
# Xiaomi CR8806 / Redmi AX3000 — kuncy7 NSS router build
# Source: kuncy7/openwrt-nss-edma (branch c3po-tag-8021q, kernel 6.18:
#         upstream stmmac/dwmac-ipq5018 MACs + qca8k DSA switch +
#         NSS PPE hardware acceleration)
#         + CR8806 device support injected from diy/cr8806/adapter-nss
#
# Standard-router profile — DHCP server / firewall / routed WAN all
# stock (PPPoE-ready). LuCI + dual-band WiFi (802.11r/k/v roaming) +
# the complete NSS offload stack (nss-tools-dwmac: firmware arm-up,
# ECM acceleration, C-3PO dsa topology on the qca8k switch, Wi-Fi
# offload on by default) + LuCI status page for it (luci-app-nss).
# First boot: diy/cr8806/99-ap-bridge-nss brands the box and
# provisions the WiFi only; the NSS plane is provisioned by the
# tree's own 98-nss-offload / 99-nss-topology uci-defaults.
#
# Config assembly, with the evidence for every block:
#   - NSS runtime + ath11k offload block: copied verbatim from the
#     tree's own validated CI seed .github/ci/ipq50xx/common.config
#     ("Seeded from the diffconfig of the validated image") — the
#     upstream community-verified combination, not improvised.
#   - Memory block: the tree's 256m group (ATH11K_MEM_PROFILE_256M +
#     NSS_MEM_PROFILE_LOW) — CR8806 has 256 MB, the same group as
#     the validated Cudy P5 / TP-Link EX511 boards.
#   - Board profile block: carried over from the 25.12 device-verified
#     immortalwrt_ap.config (LuCI + tools + WiFi pins), minus
#     ipq-wifi-redmi_ax3000 (this tree generates per-unit board.bin
#     instead of shipping a static board-2.bin — see adapter-nss).
#   - NOT carried over from the 25.12 config: irqbalance. The NSS
#     plane has its own interrupt model (nss-irq-affinity pins the
#     firmware delivery IRQs by hand after arm-up; the tree's CI
#     config does not use irqbalance either) — a generic balancer
#     would rewrite those pinning decisions on every scan.
#   - NOT carried over: kmod-ath11k-pci. The 5G radio is a QCN6122
#     AHB MPD (q6_wcss_pd2), not a PCIe card — only kmod-ath11k-ahb.
#   - kmods-extra.config (the tree's optional module repository) is
#     intentionally not used: CR8806 has no USB port and this build
#     ships a single fixed image, no per-build apk repository.
# ==================================================================
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq50xx=y
CONFIG_TARGET_qualcommax_ipq50xx_DEVICE_redmi_ax3000=y

#
# NSS runtime and the dsa plane — verbatim from the tree's validated
# CI common.config. nss-tools-dwmac pulls in the full stack (qca-dwmac
# stmmac glue, qca-nss-drv, ECM, VLAN manager, qca8337-nss + qca-dsa-nss
# fabric, ip-full) and brings the plane up in the right order at boot.
# The board lands in the C-3PO 'dsa' topology: qca8k keeps the switch,
# the ports stay as netifd generated them, and 99-nss-topology moves
# the split-CPU-link ports (WAN on eth0/GMAC0, whose PHY-to-PHY RX is
# dead on this driver — openwrt#24696) onto the SGMII conduit eth1,
# exactly as measured on the same-wiring Redmi AX5400 upstream.
#
CONFIG_PACKAGE_nss-tools-dwmac=y
CONFIG_PACKAGE_nss-firmware=y
CONFIG_NSS_FIRMWARE_VERSION_12_2=y
CONFIG_NSS_DRV_VLAN_ENABLE=y
CONFIG_PACKAGE_kmod-qca-nss-drv-pppoe=y
CONFIG_PACKAGE_kmod-qca-nss-drv-netlink=y
CONFIG_PACKAGE_nssinfo=y
CONFIG_PACKAGE_libnl-nss=y

#
# ath11k with the NSS Wi-Fi offload — verbatim from common.config.
# 2.4G (IPQ5018) and 5G (QCN6122) data paths both run in the NSS
# firmware by default (nss.general.wifi_offload=1); both radios' DTS
# sections use ath11k-fw-memory-mode 2, the mode the QCN6122 wifili
# path was measured to need on GL-B3000, so the mode-1 warning the
# topology script can emit for other boards does not apply here.
# ATH_DEBUG kept as in the validated seed: debugfs diagnostics for
# the offloaded radios (first-line tool if a radio misbehaves).
#
CONFIG_PACKAGE_MAC80211_NSS_SUPPORT=y
CONFIG_ATH11K_NSS_SUPPORT=y
CONFIG_NSS_DRV_WIFIOFFLOAD_ENABLE=y
CONFIG_NSS_DRV_WIFI_EXT_VDEV_ENABLE=y
CONFIG_PACKAGE_ATH_DEBUG=y

#
# 256 MB memory group — verbatim from the tree's validated 256m.config
# (ath11k host profile 256M + NSS LOW; same group as the validated
# Cudy P5 and TP-Link EX511 images).
#
CONFIG_ATH11K_MEM_PROFILE_256M=y
CONFIG_NSS_MEM_PROFILE_LOW=y

#
# LuCI (web UI) + Chinese translation + NSS status page
# (luci-app-nss is a package of this tree; on ipq50xx it depends on
# exactly the nss-tools-dwmac pinned above. Status -> NSS Offload
# renders nss-status: firmware state, cores, ECM acceleration counts).
#
CONFIG_PACKAGE_luci=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-app-nss=y

#
# SSH file transfer + diagnostic tools (same set as the 25.12 build;
# ip-full comes with the validated NSS block above, iperf3/ethtool/
# htop are what the throughput reports are made with)
#
CONFIG_DROPBEAR_SCP=y
CONFIG_PACKAGE_openssh-sftp-server=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_ip-full=y

#
# ===== WiFi stack =====
# Pinned explicitly so a default change can never drop a radio
# (same reasoning as the 25.12 config). No ipq-wifi package here:
# both radios load a per-unit generated bare board.bin at firmware
# request time (hotplug 12-/13-ath11k-*-bdf from adapter-nss — the
# 6.18 ath11k has no board_id override patches and the uncalibrated
# firmware reports qmi-board-id 0xFF, which no static board-2.bin
# entry of ours can match; the fallback path loads board.bin
# verbatim). One image covers both CR8806 RF generations (M79/M81).
#   kmod-ath11k-ahb                     : both radios are AHB MPDs
#   ath11k-firmware-ipq5018-qcn6122     : 2.4G + 5G firmware
#   wpad-openssl                        : full hostapd — 802.11r/k/v
#
CONFIG_PACKAGE_kmod-ath11k-ahb=y
CONFIG_PACKAGE_ath11k-firmware-ipq5018-qcn6122=y
CONFIG_PACKAGE_wpad-openssl=y

#
# Build metadata and CI — as in the tree's common.config (ccache on;
# kernel debug info off to keep the 256M image lean)
#
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_AUTOREMOVE=y
# CONFIG_KERNEL_DEBUG_INFO is not set
