# Build and Release Folders
bin-debug/
bin-release/
[Oo]bj/
[Bb]in/

# Other files and folders
.settings/

# Executables
*.swf
*.air
*.ipa
*.apk

# Project files, i.e. `.project`, `.actionScriptProperties` and `.flexProperties`
# should NOT be excluded as they contain compiler settings and other important
# information for Eclipse / Flash Builder.
/.idea/modules.xml
/.idea/misc.xml
/.idea/build_openwrt.iml

# Workspace-local scratch (never part of the build):
#   _pvenv/       - paramiko venv for on-device SSH verification
#   _iperf_win/   - Windows iperf3 client for throughput tests
#   _art_*.bin    - ART dumps of the reference units (172.16.3.19 M79,
#                   172.16.0.248 M81), input data of the per-unit BDF work
#   _nss_tree/    - NSS build tree clones (openwrt-nss-edma etc.)
/_*
/.idea/

# Python bytecode caches (py_compile of the adapter patcher)
__pycache__/
